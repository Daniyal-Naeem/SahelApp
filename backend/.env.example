# Server Configuration
PORT=4000

# MongoDB Connection
# Replace with your MongoDB connection string
# Local: mongodb://localhost:27017/sahal
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sahal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sahal

# JWT Secret Key
# IMPORTANT: Change this to a strong, random string in production
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-make-it-long-and-random

# Shared secret used to verify the payment gateway's top-up webhook signature
# (HMAC-SHA256 of the raw request body, sent in the x-webhook-signature header).
# Generate: openssl rand -hex 32
TOPUP_WEBHOOK_SECRET=change-me

# Allowed CORS origins (comma-separated). Exact matches only.
ADMIN_URL=http://localhost:5173
FRONTEND_URL=http://localhost:8081
ADDITIONAL_CORS_ORIGINS=
